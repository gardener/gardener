set -e
set -u

RESOURCE="$1"
NAME="$2"
NAMESPACE=""

if [[ "$1" != "project" ]]; then
  NAMESPACE="--namespace ${3:-$(id -u -n)}"
fi

kubectl $NAMESPACE annotate "$RESOURCE" "$NAME" confirmation.gardener.cloud/deletion=true --overwrite
kubectl $NAMESPACE delete   "$RESOURCE" "$NAME" --wait=false
